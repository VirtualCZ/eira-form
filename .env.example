# Build-time form variant (default: gas)
# VITE_FORM_VARIANT=gas
# VITE_FORM_VARIANT=icuk

# Optional: override HR API path (default /rest/sm/{variant}/v1 on rest-war)
# VITE_HR_API_BASE=/rest/sm/icuk/v1

# --- Dev only (Vite server proxy, NOT bundled into the client) ---
# HR_REST_TARGET=http://localhost:8880
# HR_REST_USER=   # optional; HR form API is public — employees must never need these
# HR_REST_PASS=
