# Variant for build / dev (restart yarn dev after change)
# VITE_FORM_VARIANT=gas
# VITE_FORM_VARIANT=icuk

# GAS credentials (inlined into dist when you build with VITE_FORM_VARIANT=gas)
# VITE_GAS_NAME=gas_sitewell
# VITE_GAS_PASS=

# ICUK credentials (inlined when VITE_FORM_VARIANT=icuk)
# VITE_ICUK_NAME=icuk_test
# VITE_ICUK_PASS=

# yarn dev only — where JBoss listens (omit if you only deploy to forms.war, never use yarn dev)
# HR_REST_TARGET=http://localhost:8880
